{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = "Legal holds"|t('lock') %}
{% set selectedSubnavItem = 'holds' %}

{% block content %}
    {% include "lock/_partials/style" %}

    <p class="light">
        {{ "A hold beats everything else here. It stops retention rules and it stops erasure requests, because “we deleted it under our automated retention policy” is not a defence to a preservation order — and Article 17(3)(e) lets you keep data needed for legal claims."|t('lock') }}
    </p>

    <table class="data fullwidth">
        <thead>
            <tr>
                <th>{{ "Who"|t('lock') }}</th>
                <th>{{ "Why"|t('lock') }}</th>
                <th>{{ "Until"|t('lock') }}</th>
                <th>{{ "Placed"|t('lock') }}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for hold in holds %}
                <tr>
                    <td>{% if hold.isSiteWide() %}<strong>{{ "Everybody"|t('lock') }}</strong>{% else %}{{ hold.email }}{% endif %}</td>
                    <td>{{ hold.reason }}</td>
                    <td>{{ hold.expiresAt ? hold.expiresAt|date('short') : "no end date"|t('lock') }}</td>
                    <td class="light">{{ hold.dateCreated|date('short') }}</td>
                    <td class="thin">
                        <form method="post">
                            {{ csrfInput() }}{{ actionInput('lock/holds/delete') }}{{ redirectInput('lock/holds') }}
                            {{ hiddenInput('holdId', hold.id) }}
                            <button type="submit" class="btn small">{{ "Lift"|t('lock') }}</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="light">{{ "No holds. Retention rules and erasure requests run normally."|t('lock') }}</td></tr>
            {% endfor %}
        </tbody>
    </table>

    <h2>{{ "Place a hold"|t('lock') }}</h2>

    <form method="post">
        {{ csrfInput() }}{{ actionInput('lock/holds/save') }}{{ redirectInput('lock/holds') }}

        {{ forms.textField({
            first: true,
            label: "Email address"|t('lock'),
            instructions: "Leave empty to hold everything, site-wide. Use that when an investigation has not yet identified whose data is involved."|t('lock'),
            name: 'email',
            type: 'email',
        }) }}

        {{ forms.textField({
            label: "Reason"|t('lock'),
            instructions: "Write it for somebody reading it in two years with no memory of the matter."|t('lock'),
            name: 'reason',
            required: true,
        }) }}

        {{ forms.dateField({label: "Until"|t('lock'), name: 'expiresAt'}) }}

        <button type="submit" class="btn submit">{{ "Place it"|t('lock') }}</button>
    </form>
{% endblock %}
