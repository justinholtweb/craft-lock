{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}
{% import "lock/_partials/macros" as lock %}

{% set title = "Data protection"|t('lock') %}
{% set selectedSubnavItem = 'overview' %}

{% block content %}
    {% include "lock/_partials/style" %}

    <div class="lock-grid">
        <div class="lock-stat">
            <h2 class="lock-stat-heading">{{ "Open requests"|t('lock') }}</h2>
            <div class="lock-figure">{{ openCount }}</div>
        </div>
        <div class="lock-stat{{ overdueCount > 0 ? ' lock-alarm' }}">
            <h2 class="lock-stat-heading">{{ "Past the deadline"|t('lock') }}</h2>
            <div class="lock-figure">{{ overdueCount }}</div>
        </div>
        <div class="lock-stat">
            <h2 class="lock-stat-heading">{{ "Erasures, 30 days"|t('lock') }}</h2>
            <div class="lock-figure">{{ erasures }}</div>
        </div>
        <div class="lock-stat{{ staleConsent > 0 ? ' lock-alarm' }}">
            <h2 class="lock-stat-heading">{{ "Consent needing re-asking"|t('lock') }}</h2>
            <div class="lock-figure">{{ staleConsent }}</div>
        </div>
    </div>

    {% if overdueCount > 0 %}
        <div class="readable"><blockquote class="note">
            <strong>{{ "{n} requests are past their statutory deadline."|t('lock', {n: overdueCount}) }}</strong>
            {{ "A late answer is itself a breach of Article 12(3), separately from whatever the request was about."|t('lock') }}
        </blockquote></div>
    {% endif %}

    <h2>{{ "Open requests"|t('lock') }}</h2>

    {% if openRequests|length %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th scope="col">{{ "Reference"|t('lock') }}</th>
                    <th scope="col">{{ "Kind"|t('lock') }}</th>
                    <th scope="col">{{ "Subject"|t('lock') }}</th>
                    <th scope="col">{{ "Status"|t('lock') }}</th>
                    <th scope="col">{{ "Due"|t('lock') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for request in openRequests %}
                    {% set days = request.daysRemaining() %}
                    <tr>
                        <td><a href="{{ url('lock/requests/' ~ request.id) }}"><code>{{ request.reference }}</code></a></td>
                        <td>{{ request.typeLabel() }}</td>
                        <td>{{ request.email }}</td>
                        <td>{{ lock.requestStatus(request) }}</td>
                        <td class="lock-due lock-{{ request.urgency() }}">
                            {%- if days is null -%}
                                {{ lock.none() }}
                            {%- elseif days < 0 -%}
                                {{ "{n} days late"|t('lock', {n: days|abs}) }}
                            {%- else -%}
                                {{ "{n} days left"|t('lock', {n: days}) }}
                            {%- endif -%}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="zilch small">{{ "Nothing outstanding."|t('lock') }}</p>
    {% endif %}

    {% if isPro %}
        {% if uncovered|length %}
            <h2>{{ "Data with no expiry"|t('lock') }}</h2>
            <div class="readable"><blockquote class="note warning">
                {{ "These sources hold personal data and no retention rule points at them, so nothing in them is ever deleted."|t('lock') }}
                <ul>
                    {% for scope in uncovered %}
                        <li><strong>{{ scope.label }}</strong>: {{ scope.description }}</li>
                    {% endfor %}
                </ul>
                <p><a class="btn" href="{{ url('lock/settings/retention') }}">{{ "Write a rule"|t('lock') }}</a></p>
            </blockquote></div>
        {% endif %}

        {% if gaps|length %}
            <h2>{{ "Register gaps"|t('lock') }}</h2>
            <div class="readable"><blockquote class="note warning">
                <ul>
                    {% for gap in gaps|slice(0, 8) %}<li>{{ gap }}</li>{% endfor %}
                </ul>
                <p><a class="btn" href="{{ url('lock/register') }}">{{ "Open the register"|t('lock') }}</a></p>
            </blockquote></div>
        {% endif %}

        {% if nextRun %}
            <p class="light">{{ "Next scheduled retention run: {date}."|t('lock', {date: nextRun|datetime('short')}) }}</p>
        {% endif %}
    {% else %}
        <div class="readable"><blockquote class="note tip">
            {{ "Retention rules, the Article 30 register and deadline reminders are in Lock Pro. Everything needed to answer a request is in this edition."|t('lock') }}
        </blockquote></div>
    {% endif %}

    <h2>{{ "Recent activity"|t('lock') }}</h2>

    {% if activity|length %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th scope="col">{{ "When"|t('lock') }}</th>
                    <th scope="col">{{ "Category"|t('lock') }}</th>
                    <th scope="col">{{ "What"|t('lock') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for entry in activity %}
                    <tr>
                        <td class="thin"><span class="light">{{ entry.dateCreated|datetime('short') }}</span></td>
                        <td class="thin">{{ lock.activityCategory(entry.category) }}</td>
                        <td>{{ entry.summary ?? entry.action }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="zilch small">{{ "Nothing yet."|t('lock') }}</p>
    {% endif %}

    <p><a href="{{ url('lock/activity') }}">{{ "The whole ledger"|t('lock') }} &rarr;</a></p>
{% endblock %}
