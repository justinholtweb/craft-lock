{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}
{% import "lock/_partials/macros" as lock %}

{% set readOnly = readOnly ?? false %}
{% set title = "Where to look"|t('lock') %}
{% set selectedSubnavItem = 'settings' %}
{% set crumbs = [{label: "Settings"|t('lock'), url: url('lock/settings')}] %}
{% set fullPageForm = not readOnly %}
{% if readOnly %}
    {% set contentNotice = readOnlyNotice() %}
{% endif %}

{% block sidebar %}
    {% include "lock/settings/_nav" with {selectedItem: 'collectors'} only %}
{% endblock %}

{% block content %}
    {% include "lock/_partials/style" %}

    {% if not readOnly %}
        {{ actionInput('lock/settings/save') }}
        {{ redirectInput('lock/settings/collectors') }}
    {% endif %}

    <p class="light">
        {{ "A disclosure is only as complete as the list of places it looked. Switching a source off makes every future disclosure say so out loud (“not searched, because it is switched off”) rather than quietly returning less."|t('lock') }}
    </p>

    <table class="data fullwidth">
        <thead>
            <tr>
                <th scope="col">{{ "Source"|t('lock') }}</th>
                <th scope="col">{{ "What it searches"|t('lock') }}</th>
                <th scope="col" class="thin">{{ "Now"|t('lock') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for handle, collector in collectors %}
                {% set skipped = handle in settings.disabledCollectors %}
                <tr>
                    <td>
                        <strong>{{ collector.label }}</strong>
                        <div class="light"><code>{{ handle }}</code></div>
                        {% if collector.scopes|length %}
                            <div class="light">{{ "Offers {n} retention scope(s)."|t('lock', {n: collector.scopes|length}) }}</div>
                        {% endif %}
                    </td>
                    <td>
                        {{ collector.description }}
                        {% if not collector.available %}
                            <div class="lock-reason">{{ collector.reason }}</div>
                        {% endif %}
                    </td>
                    <td class="thin">
                        {%- if skipped -%}
                            {{ lock.status('off', 'Skipped'|t('lock')) }}
                        {%- elseif not collector.available -%}
                            {{ lock.status('disabled', 'Not installed'|t('lock')) }}
                        {%- else -%}
                            {{ lock.status('on', 'Searched'|t('lock')) }}
                        {%- endif -%}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <hr>

    {{ forms.checkboxGroupField({
        label: "Sources to skip"|t('lock'),
        instructions: "Anything not ticked is searched. Stated this way round on purpose: a source added by a plugin update is searched by default, which is the safe direction for a list whose whole job is completeness."|t('lock'),
        id: 'disabledCollectors',
        name: 'settings[disabledCollectors]',
        options: collectors|keys|map(h => {label: collectors[h].label, value: h}),
        values: settings.disabledCollectors,
        errors: settings.getErrors('disabledCollectors'),
        disabled: readOnly,
    }) }}

    {{ forms.lightswitchField({
        label: "Search log files"|t('lock'),
        instructions: "Logs are disclosed and never rewritten: a log file is only useful because it has not been edited. Use a retention rule on whole log files instead."|t('lock'),
        id: 'scanLogs',
        name: 'settings[scanLogs]',
        on: settings.scanLogs,
        disabled: readOnly,
    }) }}

    {{ forms.editableTableField({
        label: "Other tables"|t('lock'),
        instructions: "Modules, old imports, anything Lock has never heard of. Table and column names are checked as plain identifiers both when saved and again when used."|t('lock'),
        name: 'settings[customTables]',
        id: 'customTables',
        cols: {
            table: {heading: "Table"|t('lock'), type: 'singleline', width: '20%', code: true},
            label: {heading: "Called"|t('lock'), type: 'singleline'},
            emailColumn: {heading: "Email column"|t('lock'), type: 'singleline', code: true},
            userColumn: {heading: "User ID column"|t('lock'), type: 'singleline', code: true},
            dateColumn: {heading: "Date column"|t('lock'), type: 'singleline', code: true},
            mode: {heading: "May Lock"|t('lock'), type: 'select', options: {
                read: "Only read"|t('lock'),
                anonymise: "Anonymise"|t('lock'),
                erase: "Delete"|t('lock'),
            }},
        },
        rows: settings.customTables,
        allowAdd: true,
        allowDelete: true,
        allowReorder: true,
        addRowLabel: "Add a table"|t('lock'),
        static: readOnly,
        errors: settings.getErrors('customTables'),
    }) }}
{% endblock %}
