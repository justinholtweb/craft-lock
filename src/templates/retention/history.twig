{% extends "_layouts/cp" %}

{% set title = "Run history"|t('lock') %}
{% set selectedSubnavItem = 'retention' %}
{% set crumbs = [{label: "Retention"|t('lock'), url: url('lock/retention')}] %}

{% block content %}
    {% include "lock/_partials/style" %}

    <p class="light">
        {{ "Every run keeps the plan it was given and the outcome it produced, side by side, so that “exactly what the preview said” is something anyone can check afterwards rather than something the plugin asserts."|t('lock') }}
    </p>

    <table class="data fullwidth">
        <thead>
            <tr>
                <th>{{ "When"|t('lock') }}</th>
                <th>{{ "What"|t('lock') }}</th>
                <th>{{ "Result"|t('lock') }}</th>
                <th>{{ "Deleted"|t('lock') }}</th>
                <th>{{ "Anonymised"|t('lock') }}</th>
                <th>{{ "Kept"|t('lock') }}</th>
                <th>{{ "Failed"|t('lock') }}</th>
                <th>{{ "Took"|t('lock') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for run in runs %}
                <tr>
                    <td class="thin">{{ run.dateCreated|datetime('short') }}</td>
                    <td>
                        {{ run.ruleKey ?? run.subjectEmail ?? run.type }}
                        {% if run.dryRun %}<span class="lock-action lock-action-skip">{{ "dry run"|t('lock') }}</span>{% endif %}
                        {% if run.scheduled %}<span class="lock-action lock-action-skip">{{ "scheduled"|t('lock') }}</span>{% endif %}
                        <div class="light">{{ run.summary }}</div>
                    </td>
                    <td>{{ run.status }}</td>
                    <td>{{ run.erased }}</td>
                    <td>{{ run.anonymised }}</td>
                    <td>{{ run.skipped }}</td>
                    <td{% if run.failed %} class="error"{% endif %}>{{ run.failed }}</td>
                    <td class="light">{{ run.duration }}s</td>
                </tr>
            {% else %}
                <tr><td colspan="8" class="light">{{ "Nothing has run yet."|t('lock') }}</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
