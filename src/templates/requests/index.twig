{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}
{% import "lock/_partials/macros" as lock %}

{% set title = "Requests"|t('lock') %}
{% set selectedSubnavItem = 'requests' %}

{% block actionButton %}
    <a class="btn submit add icon" href="{{ url('lock/requests/new') }}">{{ "Record a request"|t('lock') }}</a>
{% endblock %}

{% block content %}
    {% include "lock/_partials/style" %}

    <form method="get" action="{{ url('lock/requests') }}" class="lock-filters" role="search">
        <div class="lock-grow">
            {{ forms.text({
                name: 'search',
                value: search,
                type: 'search',
                class: 'fullwidth',
                placeholder: 'Reference, name or address'|t('lock'),
                inputAttributes: {aria: {label: 'Search requests'|t('lock')}},
            }) }}
        </div>
        <div>
            {{ forms.select({
                name: 'status',
                value: status,
                options: [{label: "Open"|t('lock'), value: 'open'}, {label: "All"|t('lock'), value: 'all'}]|merge(
                    statuses|keys|map(k => {label: statuses[k], value: k})
                ),
                inputAttributes: {aria: {label: 'Status'|t('lock')}},
            }) }}
        </div>
        <div><button type="submit" class="btn">{{ "Filter"|t('lock') }}</button></div>
    </form>

    {% if requests|length %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th scope="col">{{ "Reference"|t('lock') }}</th>
                    <th scope="col">{{ "Kind"|t('lock') }}</th>
                    <th scope="col">{{ "Subject"|t('lock') }}</th>
                    <th scope="col">{{ "Received"|t('lock') }}</th>
                    <th scope="col">{{ "Status"|t('lock') }}</th>
                    <th scope="col">{{ "Due"|t('lock') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for request in requests %}
                    {% set days = request.daysRemaining() %}
                    <tr>
                        <td><a href="{{ url('lock/requests/' ~ request.id) }}"><code>{{ request.reference }}</code></a></td>
                        <td>{{ request.typeLabel() }}<br><span class="light">{{ request.article() }}</span></td>
                        <td>{{ request.email }}{% if request.name %}<br><span class="light">{{ request.name }}</span>{% endif %}</td>
                        <td>{{ request.receivedAt ? request.receivedAt|date('short') : lock.none() }}</td>
                        <td>{{ lock.requestStatus(request) }}</td>
                        <td class="lock-due lock-{{ request.urgency() }}">
                            {%- if request.isClosed() -%}
                                <span class="light">{{ "closed"|t('lock') }}</span>
                            {%- elseif days is null -%}
                                {{ lock.none() }}
                            {%- elseif days < 0 -%}
                                {{ "{n} days late"|t('lock', {n: days|abs}) }}
                            {%- else -%}
                                {{ "{n} days"|t('lock', {n: days}) }}
                            {%- endif -%}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        {{ lock.capped(requests, 200) }}
    {% else %}
        <p class="zilch small">{{ "No requests match."|t('lock') }}</p>
    {% endif %}
{% endblock %}
